{
  "name": "frontend-vue",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "fix-lint": "eslint ./packages/**/src --fix",
    "lint": "eslint ./packages/**/src",
    "format": "prettier --write ./packages/**/src",
    "knip": "knip",
    "build": "caido-dev build",
    "watch": "caido-dev watch",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "list-gateways": "tsx scripts/list-gateways.ts"
  },
  "devDependencies": {
    "@caido-community/dev": "^0.1.3",
    "@caido/eslint-config": "^0.5.0",
    "@caido/tailwindcss": "0.0.1",
    "@vitejs/plugin-vue": "5.2.1",
    "dotenv": "^17.2.3",
    "eslint": "9.29.0",
    "knip": "5.70.2",
    "postcss-prefixwrap": "1.51.0",
    "prettier": "^3.8.0",
    "tailwindcss": "3.4.13",
    "tailwindcss-primeui": "0.3.4",
    "tsx": "^4.21.0",
    "typescript": "5.5.4",
    "vitest": "^4.0.17"
  }
}
